# Optional: your own ArcGIS basemap API key with appropriate online imagery rights.
# Vite values are public browser configuration: restrict the key to your site URLs.
# Without this key, EOX/GSI/USGS imagery and OpenStreetMap work immediately.
VITE_ARCGIS_API_KEY=

# Default: same-origin online tile transport (works with dev, preview and serve).
# Set true only for a fully static host with direct access to the tile providers.
VITE_DIRECT_TILES=false

# Public HTTPS Earth API root, optionally with a path prefix. Blank keeps browser
# same-origin transport; native Android with blank value uses only bundled resources.
# Example shape only (not a deployed endpoint): https://maps.example.com/
VITE_API_BASE_URL=

# On the API SERVER: exact HTTPS origins separated by commas. No wildcard/cookies.
# Capacitor Android's local resource origin is https://localhost (not an API server).
# Enable it on your authorized public relay for the App: EARTH_ALLOWED_ORIGINS=https://localhost
EARTH_ALLOWED_ORIGINS=

# For public deployment, identify this app with your real contact URL or email.
# TILE_USER_AGENT=EarthObservatory/2.0 (+https://your-own-site/contact)

# China-network imagery: your own Tianditu token authorized for server WMTS use.
# This token stays on the Node server. Do NOT prefix it with VITE_. Restart the service.
TIANDITU_TOKEN=

# Default network preference: auto | china | global. A user's manual choice wins.
# auto uses timezone + language as hints only, never an IP/geolocation lookup.
EARTH_NETWORK_REGION=auto

# Pure-static direct mode only: a separately authorized BROWSER token (public).
# With VITE_DIRECT_TILES=true, use this instead of TIANDITU_TOKEN and rebuild.
VITE_TIANDITU_TOKEN=
VITE_NETWORK_REGION=auto
